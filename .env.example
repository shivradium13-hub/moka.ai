# =============================================================================
# MOKA AI — environment template
#
# Copy to `.env` and fill in. `.env` is gitignored and must NEVER be committed.
#
# RULE: no server secret may ever be exposed through a NEXT_PUBLIC_ variable.
# The config loader (packages/config) rejects any NEXT_PUBLIC_ name that looks
# like a secret, and fails at boot rather than starting insecurely.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug

# --- API server --------------------------------------------------------------
API_PORT=4000
API_HOST=127.0.0.1
# Comma-separated origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:3000

# --- Database ----------------------------------------------------------------
# The APPLICATION role. Must be a NON-superuser without BYPASSRLS, so that
# Row-Level Security actually constrains it (docs/security.md §2.2).
DATABASE_URL=postgresql://moka_app:CHANGE_ME@127.0.0.1:5432/moka_ai

# The MIGRATION role. Owns the schema and may create tables/policies.
# The API process must never hold these credentials at runtime.
DATABASE_MIGRATION_URL=postgresql://moka_migrator:CHANGE_ME@127.0.0.1:5432/moka_ai

DATABASE_POOL_MAX=10
DATABASE_SSL=false

# --- Cache / queue -----------------------------------------------------------
# Valkey (BSD-3) — wire-compatible with Redis clients.
# Leave unset in local development to use the in-memory driver (single process
# only; it is NOT valid for production and the API refuses to start without
# this in production).
# REDIS_URL=redis://127.0.0.1:6379

# --- Cryptography ------------------------------------------------------------
# Root key-encryption key (KEK). Exactly 32 bytes, base64-encoded.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this without re-wrapping organization DEKs makes all credentials
# permanently unreadable. See docs/security.md §3.1.
ENCRYPTION_KEY=

# Signing secret for session tokens and CSRF. 32+ bytes, base64-encoded.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Session lifetime in seconds (default 30 days).
SESSION_TTL_SECONDS=2592000

# --- Web app -----------------------------------------------------------------
# Public. Safe to expose — contains no secret.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Object storage (Phase 2) ------------------------------------------------
# Driver: `local` for development, `s3` for any S3-compatible service
# (SeaweedFS, MinIO, R2). See docs/architecture.md §2 for the licensing note.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./local/storage
# STORAGE_ENDPOINT=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=

# --- AI providers (Phase 3+) -------------------------------------------------
# These are OPTIONAL fallbacks for local development only.
# In production, provider credentials belong in the Moka Credentials vault
# (encrypted, per-organization), NOT in environment variables.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Web search for the research pipeline — OPTIONAL, FREE, self-hosted
# ---------------------------------------------------------------------------
# There is deliberately no bundled search provider. The good ones are paid, and
# scraping the free ones violates their terms of service (master prompt §2).
#
# SearXNG is open source and self-hosted. With it set, the research pipeline can
# search by keyword. Without it, research still works — you supply the URLs to
# read — and the UI says which mode it is in rather than pretending otherwise.
#
# May be a private address; a self-hosted instance usually is. That exception is
# derived from this value alone and never from a request.
# SEARXNG_URL=http://127.0.0.1:8888

# ---------------------------------------------------------------------------
# Billing — no card processor is integrated
# ---------------------------------------------------------------------------
# Real money movement is not implemented, and nothing pretends it is (§45).
# Set this to true when payment is arranged outside this system — an invoice, a
# bank transfer, or a self-hosted deployment with no billing at all. An
# administrator can then activate a paid plan, and the audit log records that a
# person asserted the payment rather than the software inventing it.
#
# Left false, plan upgrades are refused with an explanation instead of appearing
# to succeed.
# BILLING_MANUAL_PAYMENTS=false
