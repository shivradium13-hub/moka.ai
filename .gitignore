# dependencies
node_modules/
.pnpm-store/

# build output
dist/
build/
.next/
out/
*.tsbuildinfo

# environment — NEVER commit real secrets
.env
.env.*
!.env.example

# turbo
.turbo/

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# test / coverage
coverage/
.vitest/

# local data
/tmp/
/local/
*.local
# The local storage driver writes uploaded files under the CWD of whichever
# process ran, which for the API is apps/api. Anchored at the root only, the
# rule above misses it — and uploaded documents are exactly what must not be
# committed.
**/local/


# editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# secrets & keys (defence in depth — these should never exist in-repo)
*.pem
*.key
*.p12
*.pfx
secrets/
