{
  "name": "moka-ai",
  "version": "0.1.0",
  "private": true,
  "description": "MOKA AI \u2014 multi-tenant AI workspace and AI workforce platform.",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:security": "vitest run --config tests/vitest.config.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "dev": "turbo run dev",
    "db:generate": "pnpm --filter @moka/db run generate",
    "db:migrate": "pnpm --filter @moka/db run migrate",
    "db:seed": "pnpm --filter @moka/db run seed",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@moka/core": "workspace:*",
    "@moka/crypto": "workspace:*",
    "@moka/db": "workspace:*",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "dotenv": "^16.4.7",
    "eslint": "^9.17.0",
    "pg": "^8.13.1",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
